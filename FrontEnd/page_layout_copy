<!-- DO KOPIOWANIA -->


<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Nazwa okna -->
    <title>Utwórz nowe konto - Dynamopedia</title>

    <!-- web-icon -->
    <link rel="icon" type="image/png" href="Zdjęcia/litery_d_cz.jpg">

    <!-- połączenie z CSS -->
    <link rel="stylesheet" href="style_program.css">

    <!-- połączenie z JS -->
    <script src="scripts.js" defer></script>

    <!-- połączenie z ikonkami -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <div class="uklad-strony">

        <!-- klasa zarządzająca lewą kolumną -->
        <aside class="lewa-kolumna"></aside>

        <!-- klasa zarządzająca ułożeniem treści na stronie -->
        <div class="tresc-strony">

        <header>
            <div id="naglowek"></div>

            <!-- skrypt tworzący nagłówek -->
            <script>
            fetch("header.html")
                .then(response => response.text())
                .then(html => {
                document.getElementById("naglowek").innerHTML = html;

                const przyciskMenu = document.getElementById("menu-toggle");
                const panelMenu = document.getElementById("panel-menu");

                przyciskMenu.addEventListener("click", function () {
                    panelMenu.classList.toggle("otwarte");
                });
            });
            </script>

            <hr>

        </header>

        </div>
        
        <!-- klasa zarządzająca prawą kolumną -->
        <aside class="prawa-kolumna"></aside>
    
    </div>

</body>
</html>